{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-gmp": "*",
        "ardenthq/arkvault-url": "^1.2",
        "arkecosystem/crypto": "dev-feat/mainsail",
        "arkecosystem/foundation": "^21.0.0",
        "blade-ui-kit/blade-icons": "^1.7",
        "brick/math": "^0.14.2",
        "doctrine/dbal": "^3.0",
        "geoip2/geoip2": "^3.3",
        "http-interop/http-factory-guzzle": "^1.2",
        "huddledigital/zendesk-laravel": "dev-master",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/horizon": "^5.29",
        "laravel/reverb": "^1.4",
        "laravel/scout": "^10.9",
        "laravel/tinker": "^3.0",
        "leigh/mt-rand": "^0.1",
        "mattiasgeniar/php-percentages": "^1.3",
        "meilisearch/meilisearch-php": "^1.9",
        "nyholm/psr7": "^1.8",
        "pusher/pusher-php-server": "^7.2",
        "react/promise": "^2.2",
        "savvot/random": "^0.3",
        "sentry/sentry-laravel": "^4.7",
        "spatie/laravel-data": "^4.18",
        "spatie/laravel-typescript-transformer": "^2.5",
        "symfony/psr-http-message-bridge": "^7.1",
        "tightenco/ziggy": "^2.6",
        "torann/geoip": "^3.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "furqansiddiqui/bip39-mnemonic-php": "^0.1",
        "laravel/boost": "^2.1",
        "laravel/dusk": "^8.2",
        "phpdocumentor/reflection-docblock": "^5.4",
        "spatie/laravel-ignition": "^2.8",
        "wnx/laravel-stats": "^2.13"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "composer/package-versions-deprecated": true,
            "treeware/plant": false,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "arkecosystem/fortify",
                "laravel/fortify",
                "livewire/livewire"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/alfonsobries/laravel-timezone.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/alfonsobries/zendesk-laravel.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --provider=\"ARKEcosystem\\Foundation\\Providers\\UserInterfaceServiceProvider\" --tag=\"pagination\" --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "build": [
            "composer format",
            "yarn format",
            "yarn prod"
        ],
        "fresh": [
            "php artisan migrate:fresh --seed"
        ],
        "play": [
            "@php artisan playbook:run DevelopmentPlaybook"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=2G"
        ],
        "format": [
            "vendor/bin/php-cs-fixer fix --config=vendor/arkecosystem/foundation/.php-cs-fixer.php"
        ],
        "refactor": [
            "./vendor/bin/rector process --config=vendor/arkecosystem/foundation/rector.php"
        ],
        "test": [
            "./vendor/bin/pest"
        ],
        "test:fast": [
            "./vendor/bin/pest --parallel"
        ],
        "test:coverage": [
            "./vendor/bin/pest --parallel --coverage --min=100 --coverage-html=.coverage --coverage-clover=coverage.xml"
        ],
        "test:browser": [
            "php artisan dusk"
        ]
    }
}
