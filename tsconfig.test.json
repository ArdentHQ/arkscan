{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "node",
        "allowJs": true,
        "allowImportingTsExtensions": false,
        "noEmit": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "esModuleInterop": true
    }
}
