includes:
	- vendor/arkecosystem/foundation/phpstan.neon

parameters:
    excludePaths:
        - app/Console/Playbooks
        - app/Console/Commands/RunPlaybookCommand.php
        - app/Services/Monitor
        - app/Testing
    ignoreErrors:
        # larastan/phpstan-strict-rules demands literal-string for DB::raw()/Expression to guard SQL injection.
        # These usages build trusted SQL with sprintf + config() values (never user input). Refactoring them to
        # parameter binding is non-trivial because some cases interpolate column/scale metadata, so suppress
        # this identifier until the SQL is rewritten with helper builders.
        -
            identifier: argument.type
            path: app/Console/Commands/CacheAnnualStatistics.php
        -
            identifier: argument.type
            path: app/Console/Commands/CacheValidatorPerformance.php
        -
            identifier: argument.type
            path: app/Models/Concerns/ForgingStats/CanBeSorted.php
        -
            identifier: argument.type
            path: app/Models/Concerns/Transaction/CanBeSorted.php
        -
            identifier: argument.type
            path: app/Models/Concerns/Wallet/CanBeSorted.php
        -
            identifier: argument.type
            path: app/Providers/EloquentServiceProvider.php
        -
            identifier: argument.type
            path: app/Repositories/WalletRepository.php
        -
            identifier: argument.type
            path: app/Services/Addresses/Aggregates/HoldingsAggregate.php
        -
            identifier: argument.type
            path: app/Services/Transactions/Aggregates/Fees/Historical/AllAggregate.php
        -
            identifier: argument.type
            path: app/Services/Transactions/Aggregates/Fees/Historical/RangeAggregate.php
        -
            identifier: argument.type
            path: app/Services/Transactions/Aggregates/Historical/RangeAggregate.php
        # Cache::remember returns mixed at runtime — the (int) cast is needed even though phpstan sees int
        -
            identifier: cast.useless
            path: app/Http/Controllers/Inertia/WalletController.php
        # The `withScope` macro in EloquentServiceProvider returns a plain Builder (no generic), so downstream
        # `paginate()->through()` sees Paginator<int, Model> instead of the concrete model type. Refactoring
        # ~14 callsites away from the macro is out of scope for the upgrade PR.
        -
            message: '#Parameter \#1 \$callback of method Illuminate\\(Pagination\\AbstractPaginator|Database\\Eloquent\\Collection)<int,Illuminate\\Database\\Eloquent\\Model>::(through|map)\(\) expects#'
            path: app/Http/Controllers/Inertia/*.php
            count: 11
        -
            message: '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection<int,Illuminate\\Database\\Eloquent\\Model>::map\(\) expects#'
            path: app/Http/Controllers/Inertia/BlocksListController.php
