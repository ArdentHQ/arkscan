includes:
	- vendor/arkecosystem/foundation/phpstan.neon

parameters:
    excludePaths:
        - app/Console/Playbooks
        - app/Console/Commands/RunPlaybookCommand.php
        - app/Services/Monitor
        - app/Testing
    ignoreErrors:
        - '#Dynamic call to static method Inertia\\Response::withMeta\(\)\.#'
